{
  "name": "dron-app",
  "private": true,
  "version": "0.1.0",
  "description": "Normativa de seguridad y clima para pilotos de drones en España: mapa 3D, viento y lluvia animados, zonas UAS y aeródromos.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:aerodromes": "node scripts/build-aerodromes.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^6.12.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.19"
  }
}
